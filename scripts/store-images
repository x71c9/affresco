#!/usr/bin/env bash
# Renders the store screenshots and the promo tile from store/screenshots/src
# into store/screenshots, as opaque PNGs (the stores reject alpha).
# First captures the sample app with the real page script (test/cdp-test.mjs)
# into store/screenshots/src/sample-capture.png.
# Requires chromium (CHROMIUM selects the binary).
set -euo pipefail

cd "$(dirname "$0")/.."
src="$PWD/store/screenshots/src"
out="$PWD/store/screenshots"
browser="${CHROMIUM:-chromium}"

node test/cdp-test.mjs "file://$src/sample-app.html" keep "$src/sample-capture.png"

render() {
  local page="$1" size="$2" file="$3"
  "$browser" --headless --disable-gpu --hide-scrollbars --allow-file-access-from-files \
    --default-background-color=ffffffff --window-size="$size" \
    --virtual-time-budget=3000 \
    --screenshot="$out/$file" "file://$src/$page" 2>/dev/null
}

render "screenshot.html#capture" 1280,800 1-capture.png
render "screenshot.html#preview" 1280,800 2-preview.png
render "screenshot.html#compare" 1280,800 3-compare.png
render promo-tile.html 440,280 promo-tile-440x280.png
ls -1 "$out"/*.png
